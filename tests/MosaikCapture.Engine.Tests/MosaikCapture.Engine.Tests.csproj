<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables; they also run through `dotnet test` (VSTest). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MosaikCapture.Engine.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- xUnit v3 without Microsoft.Testing.Platform, so `dotnet test` works without a global.json opt-in. -->
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\MosaikCapture.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScriptSerializer reads contract/contract.json, the IPC and settings contract shared with the Rust host. -->
    <Reference Include="System.Web.Extensions" />
    <None Include="..\..\contract\contract.json" Link="contract.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference images for the pixel tests (trait Category=Pixel; skipped when the fonts of the references are missing). -->
    <None Include="References\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Lets MOSAIK_UPDATE_REFERENCES=1 write new reference images back into the source tree. -->
    <AssemblyMetadata Include="ReferenceSourceDirectory" Value="$(MSBuildProjectDirectory)\References" />
  </ItemGroup>

</Project>
