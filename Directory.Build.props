<Project>

  <!-- Shared settings for the C# projects (engine and tests). The Rust host does not use MSBuild. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Features>strict</Features>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>

    <!-- Analyzers: latest .NET rules in "recommended" mode plus code style enforced at build time.
         Individual rules are tuned in .editorconfig. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unnecessary usings) to run during build; doc comments are not required. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Reproducible restores: versions are pinned in Directory.Packages.props and locked in
         packages.lock.json. CI (GitHub Actions sets CI=true) fails if a lock file is out of date. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Both projects are x64 Windows executables. On Windows the SDK infers the runtime win-x64 for them,
         on Linux (Dependabot) it does not, and the lock files then lack the win-x64 section (NU1004 in CI).
         Naming it explicitly makes every restore, on any OS, produce the same lock file. Restore only:
         the output paths stay bin/<Configuration>/net48. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Compile against the reference assemblies package instead of whatever targeting pack happens to be
       installed: identical inputs on every machine, and a lock file that matches between dev and CI. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

</Project>
